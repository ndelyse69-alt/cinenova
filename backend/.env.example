# Copy this file to .env and fill in real values. .env itself
# should never be committed to version control.

APP_ENV=local
APP_DEBUG=true

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=posterg
DB_USERNAME=
DB_PASSWORD=

TMDB_API_KEY=
TMDB_BASE_URL=https://api.themoviedb.org/3
TMDB_IMAGE_BASE=https://image.tmdb.org/t/p/w342

VIDSRC_BASE_URL=https://vidsrc.tw/embed
VIDSRC_FALLBACK_BASE_URL=https://vidsrc.ir/embed

# Newsletter email delivery (PHP mail() / server mail transport)
# Set MAIL_FROM to a real sender address on your hosting/domain.
MAIL_FROM=noreply@your-domain.com
