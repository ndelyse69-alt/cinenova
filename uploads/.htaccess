# Uploaded media only — never execute scripts from this directory,
# even if a malicious file with a .php extension somehow lands here.
<FilesMatch "\.(php|phtml|php\d|phar|pl|py|cgi|sh|exe)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
Options -ExecCGI -Indexes
AddType text/plain .php .phtml .pl .py .cgi .sh

# Browser caching for uploaded videos/posters — not "immutable"
# since an admin can replace a file at the same URL.
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType video/mp4 "access plus 7 days"
    ExpiresByType video/webm "access plus 7 days"
    ExpiresByType image/jpeg "access plus 7 days"
    ExpiresByType image/png "access plus 7 days"
    ExpiresByType image/webp "access plus 7 days"
</IfModule>
